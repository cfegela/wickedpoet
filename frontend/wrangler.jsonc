{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wickedpoet",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
