{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wickedpoet",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    { "pattern": "wickedpoet.com", "custom_domain": true },
    { "pattern": "www.wickedpoet.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
